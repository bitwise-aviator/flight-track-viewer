# Cesium ion access token (free tier) — used for Cesium World Terrain in the 3D view.
# Get one at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# MapTiler API key (free tier) — used for road/satellite/hybrid basemap styles in the 2D view.
# Get one at https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=
